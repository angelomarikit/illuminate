# Copy this file to `.env` for local development.
# In Vercel: Project Settings → Environment Variables

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here

# Public site URL (no trailing slash). Used for Open Graph / social share image links.
# Example: https://illuminate.yourdomain.com
VITE_SITE_URL=https://YOUR_PRODUCTION_DOMAIN.com

# Itexmo SMS credentials must NOT go here.
# Set them as Supabase Edge Function secrets (ITEXMO_EMAIL, ITEXMO_PASSWORD, ITEXMO_API_CODE).
# See docs/RUN_SUPABASE_SETUP.md § Itexmo SMS.
